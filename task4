class Employee:
    def __init__(self, salary):
        self._salary = salary

    def get_salary(self):
        return self._salary

    def get_role(self):
        return "Employee"


class Manager(Employee):
    def __init__(self, salary, bonus):
        super().__init__(salary)
        self.bonus = bonus

    def get_role(self):
        return "Manager"

    def get_bonus(self):
        return self.bonus


def print_employee_info(employees):
    for employee in employees:
        print(f"Role: {employee.get_role()}, Salary: {employee.get_salary()}")


emp = Employee(3000)
mgr = Manager(5000, 1000)

print_employee_info([emp, mgr])
